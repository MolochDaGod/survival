{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "grudges.grudge-studio.com",
    "survival.grudge-studio.com",
    "grudges-survival.vercel.app",
    "survival-grudgenexus.vercel.app"
  ],
  "buildCommand": "pnpm run export:systems && pnpm --filter @workspace/website build && pnpm --filter @workspace/arpg-game build && node scripts/merge-outputs.mjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "artifacts/website/dist/public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "survival.grudge-studio.com" }],
      "destination": "https://grudges.grudge-studio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/api/systems",
      "destination": "/data/grudges-systems.json"
    },
    {
      "source": "/api/systems/",
      "destination": "/data/grudges-systems.json"
    },
    {
      "source": "/api/systems/overview",
      "destination": "/data/systems-overview.json"
    },
    {
      "source": "/api/systems/perks",
      "destination": "/data/systems-perks.json"
    },
    {
      "source": "/api/systems/professions",
      "destination": "/data/systems-professions.json"
    },
    {
      "source": "/api/systems/crafting",
      "destination": "/data/systems-crafting.json"
    },
    {
      "source": "/api/systems/recipes",
      "destination": "/data/systems-recipes.json"
    },
    {
      "source": "/api/systems/buildables",
      "destination": "/data/systems-buildables.json"
    },
    {
      "source": "/api/systems/icons",
      "destination": "/data/systems-icons.json"
    },
    {
      "source": "/api/systems/township",
      "destination": "/data/systems-township.json"
    },
    {
      "source": "/api/systems/combat",
      "destination": "/data/systems-combat.json"
    },
    {
      "source": "/api/game",
      "destination": "/data/game-index.json"
    },
    {
      "source": "/api/game/",
      "destination": "/data/game-index.json"
    },
    {
      "source": "/api/game/catalog",
      "destination": "/data/game-catalog.json"
    },
    {
      "source": "/api/game/recipes",
      "destination": "/data/recipes.json"
    },
    {
      "source": "/api/game/items",
      "destination": "/data/items.json"
    },
    {
      "source": "/api/game/stations",
      "destination": "/data/stations.json"
    },
    {
      "source": "/api/:path*",
      "destination": "https://survival-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/arpg-game/locations/:path*",
      "destination": "https://assets.grudge-studio.com/locations/:path*"
    },
    {
      "source": "/arpg-game",
      "destination": "/arpg-game/index.html"
    },
    {
      "source": "/arpg-game/",
      "destination": "/arpg-game/index.html"
    },
    {
      "source": "/arpg-game/((?!assets/|ui/|vfx/|models/|textures/|locations/|icons/|lore/|fx/|audio/|favicon|.*\\..*).*)",
      "destination": "/arpg-game/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!assets/|favicon|.*\\..*).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/asset-studio",
      "destination": "/asset-studio/index.html"
    },
    {
      "source": "/asset-studio/",
      "destination": "/asset-studio/index.html"
    },
    {
      "source": "/asset-studio/((?!assets/|favicon|.*\\..*).*)",
      "destination": "/asset-studio/index.html"
    },
    {
      "source": "/info.html",
      "destination": "/info.html"
    },
    {
      "source": "/lore.html",
      "destination": "/lore.html"
    },
    {
      "source": "/stats-guide.html",
      "destination": "/stats-guide.html"
    },
    {
      "source": "/main-panel",
      "destination": "/main-panel.html"
    },
    {
      "source": "/main-panel.html",
      "destination": "/main-panel.html"
    },
    {
      "source": "/perks",
      "destination": "/perks.html"
    },
    {
      "source": "/perks.html",
      "destination": "/perks.html"
    },
    {
      "source": "/crafting",
      "destination": "/crafting.html"
    },
    {
      "source": "/crafting.html",
      "destination": "/crafting.html"
    },
    {
      "source": "/professions",
      "destination": "/professions.html"
    },
    {
      "source": "/professions.html",
      "destination": "/professions.html"
    },
    {
      "source": "/mapstarter",
      "destination": "/mapstarter.html"
    },
    {
      "source": "/mapstarter.html",
      "destination": "/mapstarter.html"
    },
    {
      "source": "/combat",
      "destination": "/combat.html"
    },
    {
      "source": "/combat.html",
      "destination": "/combat.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://id.grudge-studio.com https://*.grudge-studio.com https://puter.com https://*.puter.com https://*.puter.site"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/arpg-game/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/arpg-game/ui/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/arpg-game/vfx/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/arpg-game/models/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/arpg-game/textures/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/arpg-game/locations/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/arpg-game/icons/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ]
}